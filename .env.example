# ==============================================================================
# DocuLens AI - Master Environment Configuration Template
# ==============================================================================
# Copy to .env and customise.  Lines marked [REQUIRED] must be set for that
# provider; all others have safe defaults for local development.

# Core Application Settings
PROJECT_NAME="DocuLens AI"
VERSION="0.1.0"
ENVIRONMENT="development"            # development | testing | production
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Logging & CORS
LOG_LEVEL="INFO"                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"  # Comma-separated origins, e.g. http://localhost:3000,https://app.example.com

# Rate Limiting (Lightweight in-process protection)
RATE_LIMIT_ENABLED=false             # Set to 'true' in public / shared deployments
RATE_LIMIT_MAX_REQUESTS=60          # Maximum requests per client IP per window
RATE_LIMIT_WINDOW_SECONDS=60.0       # Window size in seconds

# Document Ingestion & Storage
UPLOAD_DIR="data/uploads"
RENDER_OUTPUT_DIR="data/rendered_pages"
MAX_UPLOAD_SIZE_BYTES=10485760

# Vector Database (Qdrant)
# Use ':memory:' for transient local testing, or 'http://localhost:6333' / 'http://qdrant:6333' for Docker
QDRANT_LOCATION=":memory:"
QDRANT_URL=""
QDRANT_API_KEY=""                    # [REQUIRED when using hosted Qdrant Cloud]
QDRANT_COLLECTION_NAME="document_chunks"
QDRANT_VISUAL_COLLECTION_NAME="visual_pages"

# AI Provider Configuration (BYOK - Bring Your Own Key)
# Supported LLM_PROVIDER options: 'mock', 'gemini', 'openai'
LLM_PROVIDER="mock"                 # 'mock' needs no key; safe for dev/test
LLM_MODEL="gemini-3.7-flash"
GEMINI_API_KEY=""                    # [REQUIRED when LLM_PROVIDER=gemini]
LLM_API_KEY=""                       # [REQUIRED when LLM_PROVIDER=openai]
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000

# Retrieval & Reranker Settings
DEFAULT_RETRIEVAL_TOP_K=5
DEFAULT_HYBRID_STRATEGY="weighted"
DEFAULT_WEIGHT_DENSE=0.5
DEFAULT_WEIGHT_BM25=0.3
DEFAULT_WEIGHT_VISUAL=0.2
RERANKER_MODEL_NAME="Xenova/ms-marco-MiniLM-L-6-v2"
DEFAULT_RERANK_TOP_K=5

